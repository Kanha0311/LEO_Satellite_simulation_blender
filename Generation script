import bpy
import numpy as np
from math import radians

# ============================================================
# PATHS
# ============================================================
BASE_PATH = bpy.path.abspath("//")
DATA_PATH = BASE_PATH + "data/sat_positions.npy"

# ============================================================
# CONSTANTS
# ============================================================
EARTH_RADIUS = 6.371        # Blender units (1000 km)
SAT_RADIUS   = 0.075
SCALE        = 1 / 1000     # km → Blender units

# ============================================================
# CLEAN SCENE
# ============================================================
bpy.ops.object.select_all(action='SELECT')
bpy.ops.object.delete(use_global=False)

# ============================================================
# LOAD DATA
# ============================================================
positions = np.load(DATA_PATH)
n_frames, n_sats, _ = positions.shape

scene = bpy.context.scene
scene.frame_start = 1
scene.frame_end = n_frames
scene.render.fps = 24

# ============================================================
# EARTH
# ============================================================
bpy.ops.mesh.primitive_uv_sphere_add(
    radius=EARTH_RADIUS,
    segments=128,
    ring_count=64,
    location=(0, 0, 0)
)
earth = bpy.context.object
earth.name = "Earth"

# Simple material
mat_earth = bpy.data.materials.new("Earth_Mat")
mat_earth.use_nodes = True
bsdf = mat_earth.node_tree.nodes["Principled BSDF"]
bsdf.inputs["Base Color"].default_value = (0.02, 0.05, 0.1, 1)
bsdf.inputs["Roughness"].default_value = 0.9
earth.data.materials.append(mat_earth)

# ============================================================
# SATELLITE MATERIAL
# ============================================================
mat_sat = bpy.data.materials.new("Sat_Mat")
mat_sat.use_nodes = True
bsdf = mat_sat.node_tree.nodes["Principled BSDF"]
bsdf.inputs["Base Color"].default_value = (0.3, 0.9, 1.0, 1)
#bsdf.inputs["Emission"].default_value = (0.1, 0.6, 1.0, 1)
#bsdf.inputs["Emission Strength"].default_value = 2.0

# ============================================================
# CREATE SATELLITES
# ============================================================
sats = []

for i in range(5):
    bpy.ops.mesh.primitive_uv_sphere_add(radius=SAT_RADIUS)
    obj = bpy.context.object
    obj.name = f"SAT_{i:03d}"
    obj.data.materials.append(mat_sat)
    sats.append(obj)

# ============================================================
# ANIMATE SATELLITES
# ============================================================
for f in range(n_frames):
    scene.frame_set(f + 1)

    for i, obj in enumerate(sats):
        x, y, z = positions[f, i] * SCALE
        obj.location = (x, y, z)
        obj.keyframe_insert("location")

# ============================================================
# CAMERA
# ============================================================
bpy.ops.object.camera_add(
    location=(18, -18, 12),
    rotation=(radians(60), 0, radians(45))
)
cam = bpy.context.object
scene.camera = cam

# ============================================================
# LIGHTING
# ============================================================
bpy.ops.object.light_add(type='SUN', location=(0, 0, 50))
sun = bpy.context.object
sun.data.energy = 5
earth.rotation_euler[2] = 0
earth.keyframe_insert("rotation_euler", frame=1)
earth.rotation_euler[2] = radians(360 * n_frames / 1436)
earth.keyframe_insert("rotation_euler", frame=n_frames)

print("Scene build complete.")
